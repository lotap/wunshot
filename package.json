{
  "name": "root",
  "private": true,
  "author": {
    "name": "lotap",
    "url": "https://twitter.com/lotap_dev"
  },
  "license": "FSL-1.1-MIT",
  "scripts": {
    "build": "turbo run build",
    "build:docs": "turbo run build --filter=docs",
    "build:cli": "turbo run build --filter=wunshot",
    "dev": "turbo run dev",
    "dev:docs": "turbo run dev --filter=docs",
    "dev:cli": "turbo run dev --filter=wunshot",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "release:cli": "pnpm build:cli && pnpm changeset version && pnpm changeset publish"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.6.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@changesets/cli": "^2.29.8"
  },
  "packageManager": "pnpm@10.26.0"
}
