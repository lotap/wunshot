      "files": [
        {
          "path": "modules/core/helpers/consts.ts",
          "type": "registry:lib",
          "target": "db/helpers/consts.ts"
        },
        {
          "path": "modules/core/helpers/cols.ts",
          "type": "registry:lib",
          "target": "db/helpers/cols.ts"
        },
        {
          "path": "modules/core/models/users/schemas.ts",
          "type": "registry:lib",
          "target": "db/models/users/schemas.ts"
        }
      ]
    }
  ]
}
