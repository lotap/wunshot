{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "wunshot",
  "homepage": "https://registry.wunshot.dev",
  "items": [
    {
      "name": "quick-start",
      "type": "registry:block",
      "title": "Quick Start",
